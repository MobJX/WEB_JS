<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd" version="4.0">
  <display-name>NewAstaOnlineJS</display-name>
  <welcome-file-list>
    <welcome-file>index.html</welcome-file>
  </welcome-file-list>
  
  <context-param>
    <param-name>dbUrl</param-name>
    <param-value>jdbc:mysql://localhost:3306/myastadb?serverTimezone=UTC</param-value>
  </context-param>
  <context-param>
    <param-name>dbUser</param-name>
    <param-value>root</param-value>
  </context-param>
  <context-param>
    <param-name>dbPassword</param-name>
    <param-value>Monica0407,.</param-value>
  </context-param>
  <context-param>
    <param-name>dbDriver</param-name>
    <param-value>com.mysql.cj.jdbc.Driver</param-value>
  </context-param>
  
  <filter> 
      <filter-name>LoginChecker</filter-name>
      <filter-class>it.polimi.tiw.asta.filters.LoginChecker</filter-class> 
 </filter> 
 
  <filter> 
      <filter-name>NoCacher</filter-name>
      <filter-class>it.polimi.tiw.asta.filters.NoCacher</filter-class> 
 </filter> 
  <filter-mapping> 
    <filter-name>NoCacher</filter-name> 
    <url-pattern>/homePage.html</url-pattern> 
 </filter-mapping> 
 
  <filter-mapping> 
    <filter-name>LoginChecker</filter-name> 
    <url-pattern>/CloseMission</url-pattern> 
    <url-pattern>/CreateExpensesReport</url-pattern> 
    <url-pattern>/CreateMission</url-pattern> 
    <url-pattern>/GetMissionDetailsData</url-pattern> 
    <url-pattern>/GetMissionsData</url-pattern> 
    <url-pattern>/Logout</url-pattern> 
    <url-pattern>/homePage.html</url-pattern> 
 </filter-mapping> 
 
</web-app>